# Copy to .env and adjust. Used by docker-compose.
# .env is gitignored — never commit real tokens.

# Host path to the CScalp / FSR Launcher per-day HTML logs (mounted read-only).
CSCALP_LOG_ROOT_HOST=C:/Program Files (x86)/FSR Launcher/SubApps/CS/Log

# Port the dashboard is published on.
CSCALP_WEB_PORT=8777

# Container timezone — must match the log timestamps / folder dates.
TZ=Europe/Moscow

# Telegram (optional). Leave blank to disable posting.
# Token from @BotFather; chat_id is the channel id (e.g. -100...).
TG_TOKEN=
TG_CHAT_ID=
